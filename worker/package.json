{
  "name": "ergora-specialists-gateway",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "preflight": "node scripts/preflight.mjs",
    "deploy": "node scripts/preflight.mjs && wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && node scripts/preflight.mjs --config-only && wrangler deploy --dry-run --outdir .wrangler/dry"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  }
}
